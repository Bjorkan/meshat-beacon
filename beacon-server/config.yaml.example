# Beacon configuration file
# Copy to config.yaml and adjust as needed.

iatas:
  YVR:
    name: Vancouver International
    lat: 49.1967
    lng: -123.1815
    # borderFile: borders/yvr.geojson   # optional GeoJSON Feature (Polygon/MultiPolygon)
    #                                    # for the region border map; path is relative to
    #                                    # this file's directory; validated at boot.
  YYJ:
    name: Victoria International
    lat: 48.6469
    lng: -123.4260
  YYC:
    name: Calgary International
    lat: 51.1139
    lng: -114.0200
  YEG:
    name: Edmonton International
    lat: 53.3097
    lng: -113.5797
  YOW:
    name: Ottawa International
    lat: 45.3225
    lng: -75.6692
  YYZ:
    name: Toronto Pearson
    lat: 43.6777
    lng: -79.6248

regions:
  - slug: western-canada
    name: Western Canada
    display_order: 1
    center_lat: 51.0
    center_lng: -114.0
    zoom_level: 5
    iatas: [YVR, YYJ, YYC, YEG]

  - slug: eastern-canada
    name: Eastern Canada
    display_order: 2
    center_lat: 45.0
    center_lng: -75.0
    zoom_level: 5
    iatas: [YOW, YYZ]

channel_keys:
  # Hashtag channels: Beacon derives the PSK automatically from the tag name.
  # secret = SHA256("#tag")[:16], channel_hash = SHA256(secret)[0]
  # Hashtag names should be provided without the # prefix.
  # Beacon prepends # automatically before deriving the key.
  hashtags:
    - meshcore

  # Explicit keys: provide the channel hash (hex) and key (hex) directly.
  # An optional name can be set for display purposes.
  # Set public: true for the public channel; other explicit keys are private.
  keys:
    "11":
      key: "8b3387e9c5cdea6ac9e5edbaa115cd72"
      name: "Public"
      public: true

# Regional transport scopes for matching TRANSPORT_FLOOD packets.
# Plain names have # prepended automatically (e.g. "bc" → "#bc").
scopes:
  - name: bc
  - name: "#west"

telemetry:
  retention: 672h   # 4 weeks
  resolution: 1h    # store one snapshot per observer per hour

packets:
  retention: 720h   # 30 days

# Known-route retention. Routes are distilled packet history (the path a packet
# took, hop by hop), so they may outlive packets.retention; there is no required
# relationship between the two.
routes:
  # How long a route is kept after it was last observed. Every new observation
  # of the same path resets this clock, so routes the mesh still uses never
  # expire -- only paths nothing has traveled for this long age out.
  retention: 336h   # 14 days
  # Shorter window for rarely-seen routes: one observed fewer than
  # min_observations times in total is dropped once it goes unobserved for
  # this long. Must be shorter than retention, or it never applies.
  grace: 168h       # 7 days
  # Lifetime observation count a route must reach to earn the full retention
  # window. Below it a route is treated as flood noise -- a path recorded once
  # or twice and never confirmed -- and only kept for the grace window. The
  # count never resets, so once a route crosses this bar it stays in the
  # retention tier for good.
  min_observations: 3

# Neighbor edges between nodes (drawn from 3-byte path hashes and /neighbors
# reports). An edge that gets no fresh confirmation -- neither source sees the
# pair again -- is dropped once it ages past retention.
#neighbors:
#  retention: 168h   # default: 7 days
#  # Direct LoRa sanity cap: two nodes with known coordinates further apart
#  # than this can't hear each other, so no edge is recorded between them, and
#  # a /neighbors report containing even one such impossible pair is discarded
#  # whole (packets reach other regions via MQTT interconnects — those hops
#  # are not radio hops).
#  max_distance_km: 150   # default: 150
#  # How long a MeshCore region-scope confirmation (observer self-report or a
#  # neighbor entry answered with status == "responded") counts as current for
#  # the map's MeshCore Region filter. Timeouts preserve the old value and its
#  # old timestamp. Defaults to 168h, matching neighbors.retention.
#  region_scope_freshness: 168h

# Route planner (/routes/best) edge cost model. Each leg costs a signal term
# minus a traffic-evidence discount, floored per leg at snr_strong_cap: a
# fresh SNR reading at/above snr_good_db costs the cap; between snr_good_db
# and snr_bad_db the signal term interpolates toward snr_max_penalty with a
# kink at 0 dB (sub-zero readings degrade faster per dB, so every step down
# into the negative costs more than a step down while still positive);
# unmeasured or stale legs pay unmeasured_penalty as their signal term
# instead, which must stay >= snr_max_penalty so a speculative leg (no
# trustworthy traffic) always costs more than any measured leg. Proven
# traffic (the directed pair's merged observation_count: every packet that
# demonstrably crossed the hop) discounts the signal term on a log10 scale
# up to traffic_max_discount at traffic_full_count observations -- BUT only
# for unambiguous evidence: exact pubkey identity or a 2+ byte hash that
# resolved to exactly one node globally (same uniqueness rule the rest of
# the system holds). A 1-byte hash NEVER discounts (any node could have
# been the hop), legacy rows without provenance fail closed, a moved node
# deletes all its edges at ingest, and legs beyond 150 km never plan. So
# hundreds of unambiguous passed packets discount far more than a handful,
# letting a proven-but-SNR-less hop (HuskvarnaS -> Gisebo ~1000 obs)
# outrank a weak measured hop with thin history. Unmeasured legs earn the
# full discount (traffic is their only quality signal, floored at
# unmeasured_floor); measured legs earn only traffic_measured_share of it,
# so SNR stays the primary signal where it exists. The reporter marking its
# peer as a neighbor (directional, freshly confirmed within
# direct_freshness) discounts weak/interpolated legs by neighbor_bonus and
# marks the leg neighbor=true in the API, which must stay below
# (unmeasured_penalty - snr_max_penalty) so a speculative leg still loses to
# every measured leg. neighbor_bonus: 0 disables ONLY the routing discount
# -- a freshly confirmed edge still reports neighbor=true.
# direct_freshness: 0 disables BOTH bonus and badge (no confirmation is ever
# fresh).
#
# All fields are optional and unset means "use the default". An explicit value
# -- including 0 -- is honored: max_alternatives: 0 disables alternatives.
# Partial blocks are validated AFTER defaults are applied, so e.g.
# neighbor_bonus: 10 alone is rejected (it would zero out costs against the
# default penalties).
#routeplan:
#  unmeasured_penalty: 2.5  # default: 2.5
#  snr_good_db: 5.0         # default: 5.0
#  snr_bad_db: -15.0        # default: -15.0
#  snr_max_penalty: 2.0     # default: 2.0
#  snr_strong_cap: 0.25     # default: 0.25; cheapest any leg can get
#  traffic_max_discount: 4.0  # default: 4.0; 0 disables traffic evidence
#  traffic_full_count: 1000   # default: 1000 obs earn the full discount
#  traffic_measured_share: 0.125  # default: 0.125 of the discount for measured legs
#  unmeasured_floor: 0.4    # default: 0.4; proven unmeasured never beats strong measured
#  neighbor_bonus: 0.4      # default: 0.4
#  snr_freshness: 168h      # default: 168h (7 days, the neighbor retention window)
#  direct_freshness: 168h   # default: same as snr_freshness; how long a direct
#                           # confirmation keeps earning the neighbor bonus
#  max_hops: 12             # default: 12
#  max_alternatives: 2      # default: 2; the /routes/best API caps alternatives at 0-2

websocket:
  max_connections_per_ip: 5 # default: 5

# Node staleness, deletion, and clock-drift thresholds.
#nodes:
#  stale_threshold: 24h          # default: 24h
#  delete_after: 720h            # default: 30 days, same default as packets.retention
#  clock_drift_threshold: 5m     # default: 5m
#  iata_membership_ttl: 168h    # default: 7 days; IATA badges older than this stop counting

# Observer retention. An observer that has not been heard from (packet, status,
# or neighbors traffic) for this long is deleted by the cleanup job, along
# with its brokers, scopes, telemetry, locations and owner mapping. Historical
# packet observations keep a snapshot of the observer's identity and continue
# to follow packets.retention, so deleting a stale observer never shortens
# packet history. A public key that starts publishing again is recreated
# cleanly by normal ingest.
#observers:
#  delete_after: 336h            # default: 14 days

# CORS configuration.
# Controls which origins, methods and headers are allowed for cross-origin requests.
# Defaults to allowing all origins with GET/HEAD/OPTIONS if omitted — appropriate
# for a public read-only API. Restrict allowed_origins if you expose write endpoints.
#cors:
#  allowed_origins:
#    - "https://app.example.com"
#  allowed_methods: [GET, HEAD, OPTIONS, POST]
#  allowed_headers: [Accept, Authorization, Content-Type]
#  allow_credentials: false
#  max_age: 300

# Redis caching layer.
# If REDIS_ADDR is not set, caching is disabled and all reads go directly to PostgreSQL.
# TTLs are specified as duration strings e.g. "30m", "1h", "2h".
# Per-category TTLs override the global ttl. Any category left unset inherits ttl.
cache:
  # Global default TTL for all cached responses. Defaults to 1h if not set.
  ttl: "1h"
  ttls:
    # Aggregated stats endpoints (overview, observations, breakdowns, top nodes/observers,
    # radio presets, scope stats). Backed by materialized views refreshed hourly.
    stats: "1h"
    # Mostly-static reference data (IATAs, regions, scopes).
    # Only changes when new observers arrive or config is reseeded.
    reference: "1h"
    # Individual node detail. Also explicitly invalidated on upsert.
    nodes: "1h"
    # Individual observer detail. Also explicitly invalidated on upsert.
    observers: "1h"

# Geographic ingest filter (optional).
# Drop packets from observers outside the specified area at ingest time.
# Country codes are ISO 3166-1 alpha-2 (e.g. CA, US, GB).
# Continent codes: AF (Africa), AN (Antarctica), AS (Asia),
#                  EU (Europe), NA (North America), OC (Oceania), SA (South America).
# If both are set an IATA passes if it matches either (OR semantics).
# Omit this section entirely to accept packets from all IATAs (default).
#ingest:
#  owner_metadata: false # optional privileged owner feed; requires MQTT_OWNER_USERNAME/PASSWORD
#  allow_countries: [CA, US]
#  allow_continents: [NA]

# Background task intervals.
# Shorter intervals are useful during initial deployment to confirm data is
# flowing. Back off to 1h or more once stable.
#background:
#  view_refresh: 1h   # default: 1h
#  reconfirm: 1h      # default: 1h
#  cleanup: 1h        # default: 1h
